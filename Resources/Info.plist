<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Copilot Pulse</string>
	<key>CFBundleExecutable</key>
	<string>CopilotPulse</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.asaf.CopilotPulse</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Copilot Pulse</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- The build sets CFBundleVersion to this version too: Sparkle compares it to find updates. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Asaf Manassen. Licensed under GPL-3.0-or-later.</string>
	<!-- Sparkle: the appcast is an asset of the latest GitHub release. -->
	<key>SUFeedURL</key>
	<string>https://github.com/mnsn/copilot-pulse/releases/latest/download/appcast.xml</string>
	<!-- Updates, the appcast and its release notes must be signed with this key's private key.
	     Never change it: installed apps would reject every update (see CONTRIBUTING.md). -->
	<key>SUPublicEDKey</key>
	<string>19vCJ0zNS7ujM7R2zIFCkSy6oPxaKbjiUJZX05x82vI=</string>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<!-- Never fall back to accepting an unsigned appcast. The fallback is for rotating keys with a
	     Developer ID signature, which this app doesn't have. -->
	<key>SUSignedFeedFailureExpirationInterval</key>
	<integer>0</integer>
</dict>
</plist>
